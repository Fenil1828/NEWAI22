{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "Frontend/dist",
  "framework": "vite",
  "rewrites": [
    { 
      "source": "/api/:path*", 
      "destination": "https://aichatbot-backend.vercel.app/api/:path*" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}